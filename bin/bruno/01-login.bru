meta {
  name: Login (guarda o token)
  type: http
  seq: 2
}

post {
  url: http://localhost:8080/auth/login
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "email": "ana@email.com",
    "senha": "123456"
  }
}

vars:post-response {
  token: res.body.token
}
